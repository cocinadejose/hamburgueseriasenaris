RewriteEngine On

# ============================================
# 1. PROTECCIÓN DE ARCHIVOS SENSIBLES (PRIMERO)
# ============================================
# Bloquear acceso a archivos y directorios sensibles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Proteger archivos específicos
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|config|ffs_batch|ffs_db|py)$">
    Require all denied
</FilesMatch>

# Bloquear la carpeta de copias de seguridad (evita contenido duplicado)
RewriteRule ^backup/ - [F,L]

# ============================================
# 2. FORZAR HTTPS Y NO-WWW (REDIRECCIÓN EXTERNA)
# ============================================
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ============================================
# 3. REDIRECCIÓN DE IDIOMA (SOLO RAÍZ)
# ============================================
RewriteCond %{REQUEST_URI} ^/(index\.html)?$
RewriteCond %{HTTP:Accept-Language} ^([a-z]{2}) [NC]
RewriteCond %{DOCUMENT_ROOT}/%1 -d
RewriteRule ^(index\.html)?$ /%1/ [R=301,L]

# Fallback a /es/ si no hay idioma detectado
RewriteCond %{REQUEST_URI} ^/(index\.html)?$
RewriteRule ^(index\.html)?$ /es/ [R=301,L]

# ============================================
# 3b. REDIRECCIONES 301 — URLs ATEMPORALES (familias A y B)
# ============================================
# Estas páginas se publicaron con "-2026" en la URL. Ahora son atemporales:
# se redirigen 301 las URLs antiguas (con y sin .html) a las nuevas sin año,
# para no perder enlaces, hreflang ni posicionamiento.
#
# Familia A — Fiestas del Apóstol Santiago (migrada 2026-10-09)
RewriteRule ^es/blog/fiestas-apostol-santiago-2026(\.html)?/?$ /es/blog/fiestas-apostol-santiago [R=301,L]
RewriteRule ^en/blog/apostle-santiago-festivals-2026(\.html)?/?$ /en/blog/apostle-santiago-festivals [R=301,L]
RewriteRule ^fr/blog/fetes-apotre-saint-jacques-2026(\.html)?/?$ /fr/blog/fetes-apotre-saint-jacques [R=301,L]
RewriteRule ^de/blog/apostel-jakobus-feste-2026(\.html)?/?$ /de/blog/apostel-jakobus-feste [R=301,L]
RewriteRule ^it/blog/feste-apostolo-giacomo-2026(\.html)?/?$ /it/blog/feste-apostolo-giacomo [R=301,L]
RewriteRule ^pt/blog/festas-apostolo-santiago-2026(\.html)?/?$ /pt/blog/festas-apostolo-santiago [R=301,L]
RewriteRule ^ja/blog/apostle-santiago-festivals-2026(\.html)?/?$ /ja/blog/apostle-santiago-festivals [R=301,L]
RewriteRule ^zh/blog/apostle-santiago-festivals-2026(\.html)?/?$ /zh/blog/apostle-santiago-festivals [R=301,L]
RewriteRule ^ko/blog/apostle-santiago-festivals-2026(\.html)?/?$ /ko/blog/apostle-santiago-festivals [R=301,L]
#
# Familia B — Grandes Fiestas de Santiago (migrada 2026-10-10)
RewriteRule ^es/blog/fiestas-santiago-2026(\.html)?/?$ /es/blog/fiestas-santiago [R=301,L]
RewriteRule ^en/blog/santiago-festivals-2026(\.html)?/?$ /en/blog/santiago-festivals [R=301,L]
RewriteRule ^fr/blog/fetes-saint-jacques-2026(\.html)?/?$ /fr/blog/fetes-saint-jacques [R=301,L]
RewriteRule ^de/blog/santiago-feste-2026(\.html)?/?$ /de/blog/santiago-feste [R=301,L]
RewriteRule ^it/blog/feste-santiago-2026(\.html)?/?$ /it/blog/feste-santiago [R=301,L]
RewriteRule ^pt/blog/festas-santiago-2026(\.html)?/?$ /pt/blog/festas-santiago [R=301,L]
RewriteRule ^ja/blog/santiago-festivals-2026(\.html)?/?$ /ja/blog/santiago-festivals [R=301,L]
RewriteRule ^zh/blog/santiago-festivals-2026(\.html)?/?$ /zh/blog/santiago-festivals [R=301,L]
RewriteRule ^ko/blog/santiago-festivals-2026(\.html)?/?$ /ko/blog/santiago-festivals [R=301,L]

# ============================================
# 4. QUITAR .HTML DE LA URL (REDIRECCIÓN EXTERNA)
# ============================================
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# ============================================
# 5. SERVIR .HTML INTERNAMENTE (SIN MOSTRAR EXTENSIÓN)
# ============================================
# Solo aplicar si no es un archivo o directorio existente
# Y solo para rutas que no tengan extensión conocida
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|gif|avif|webp|svg|ico|xml|txt|pdf|woff|woff2|ttf|eot)$ [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ $1.html [L]




